{
  "name": "@iotanalytics/client",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript SDK for the IoTAnalytics Engine: typed REST client, resumable SSE feed, and a fleet state reducer for field-ops dashboards and mobile apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "!dist/**/*.test.*"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
